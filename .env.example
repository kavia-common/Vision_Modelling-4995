# Vision Modelling Backend (MVP) - Environment variables example

# Network
PORT=3001
SERVER_HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO

# CORS
# Comma-separated list of allowed origins; use '*' to allow all (dev only)
CORS_ALLOW_ORIGINS=*

# Storage
# Optional override for data directory; default is ./data under the project root
# DATA_DIR=/home/app/data
